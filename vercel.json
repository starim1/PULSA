{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/manifest.json", "destination": "/public/manifest.json" },
    { "source": "/icon.svg", "destination": "/public/icon.svg" },
    { "source": "/(.*)", "destination": "/public/index.html" }
  ],
  "functions": {
    "api/ai.js": {
      "maxDuration": 60
    }
  }
}
